rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email' in request.auth.token && request.auth.token.email == 'davidelvisaghamomwan@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGeoCellId(cellId) {
      return cellId is string && cellId.size() >= 3 && cellId.size() <= 6 && cellId.matches('^[0-9b-hjkmnp-z]+$');
    }

    function isValidGeoHashString(gh) {
      return gh is string && gh.size() >= 4 && gh.size() <= 12 && gh.matches('^[0-9b-hjkmnp-z]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidVisibility(val) {
      return val in ['EVERYONE', 'MATCHES_AND_FRIENDS', 'FRIENDS_ONLY', 'FOLLOWERS_ONLY'];
    }

    function isValidStoragePath(path) {
      return path is string && path.size() <= 512 && (path == '' || path.matches('^(users|profile_pictures)/.*'));
    }

    function isValidStoragePathList(paths, maxLen) {
      return paths is list && paths.size() <= maxLen && (paths.size() == 0 || isValidStoragePath(paths[0]));
    }

    function isValidCommentReplyFields(data) {
      return (!('replyToCommentId' in data) || (data.replyToCommentId is string && isValidId(data.replyToCommentId))) &&
             (!('replyToAuthorName' in data) || (data.replyToAuthorName is string && data.replyToAuthorName.size() >= 1 && data.replyToAuthorName.size() <= 40)) &&
             (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() >= 1 && data.replyToText.size() <= 140));
    }

    // --- Entity Validation Helpers ---
    function isValidPrivateUser(data) {
      return data.userId is string && isValidId(data.userId) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             data.interestedIn in ['Everyone', 'Women', 'Men', 'Non-binary'] &&
             data.minAgePref is int && data.minAgePref >= 18 && data.minAgePref <= 99 &&
             data.maxAgePref is int && data.maxAgePref >= data.minAgePref && data.maxAgePref <= 99 &&
             data.maxDistanceKm is int && data.maxDistanceKm >= 5 && data.maxDistanceKm <= 500 &&
             (!('hideOnlineStatus' in data) || data.hideOnlineStatus is bool) &&
             (!('exactLatitude' in data) || (data.exactLatitude is number && data.exactLatitude >= -90.0 && data.exactLatitude <= 90.0)) &&
             (!('exactLongitude' in data) || (data.exactLongitude is number && data.exactLongitude >= -180.0 && data.exactLongitude <= 180.0));
    }

    function isValidSharedProfileFields(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40 &&
             data.age is int && data.age >= 18 && data.age <= 99 &&
             data.gender in ['Woman', 'Man', 'Non-binary'] &&
             data.bio is string && data.bio.size() <= 400 &&
             data.cityLabel is string && data.cityLabel.size() >= 1 && data.cityLabel.size() <= 80 &&
             (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
             data.coarseLatitude is number && data.coarseLatitude >= -90.0 && data.coarseLatitude <= 90.0 &&
             data.coarseLongitude is number && data.coarseLongitude >= -180.0 && data.coarseLongitude <= 180.0 &&
             data.interests is list && data.interests.size() <= 8 &&
             (data.interests.size() == 0 || (data.interests[0] is string && data.interests[0].size() <= 40)) &&
             (!('photoDataUrl' in data) || (data.photoDataUrl is string && data.photoDataUrl.size() <= 180000)) &&
             (!('photoStoragePath' in data) || isValidStoragePath(data.photoStoragePath)) &&
             (!('profilePhotos' in data) || (data.profilePhotos is list && data.profilePhotos.size() <= 12 && (data.profilePhotos.size() == 0 || (data.profilePhotos[0] is string && data.profilePhotos[0].size() <= 180000)))) &&
             (!('photoStoragePaths' in data) || isValidStoragePathList(data.photoStoragePaths, 12)) &&
             data.avatarSeed is string && data.avatarSeed.size() >= 1 && data.avatarSeed.size() <= 40 &&
             data.discoverable is bool &&
             (!('suspended' in data) || data.suspended is bool) &&
             (!('hideOnlineStatus' in data) || data.hideOnlineStatus is bool) &&
             (!('photosVisibility' in data) || isValidVisibility(data.photosVisibility)) &&
             (!('videosVisibility' in data) || isValidVisibility(data.videosVisibility)) &&
             (!('infoVisibility' in data) || isValidVisibility(data.infoVisibility)) &&
             (!('dateOfBirth' in data) || (data.dateOfBirth is string && data.dateOfBirth.size() <= 16)) &&
             (!('profileCompleted' in data) || data.profileCompleted is bool) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 40)) &&
             (!('pronouns' in data) || (data.pronouns is string && data.pronouns.size() <= 30)) &&
             (!('profileLink' in data) || (data.profileLink is string && data.profileLink.size() <= 200)) &&
             (!('pageInfo' in data) || (data.pageInfo is string && data.pageInfo.size() <= 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 60));
    }

    function isValidPublicProfile(data) {
      return isValidSharedProfileFields(data) &&
             (!('geohash' in data) || isValidGeoHashString(data.geohash)) &&
             (!('geohash3' in data) || (data.geohash3 is string && data.geohash3.size() == 3 && data.geohash3.matches('^[0-9b-hjkmnp-z]{3}$'))) &&
             (!('geohash4' in data) || (data.geohash4 is string && data.geohash4.size() == 4 && data.geohash4.matches('^[0-9b-hjkmnp-z]{4}$')));
    }

    function isValidGeoCellProfile(data, cellId) {
      return isValidSharedProfileFields(data) &&
             isValidGeoHashString(data.geohash) &&
             data.geohash.matches('^' + cellId + '.*') &&
             data.cellPrecision is int &&
             data.cellPrecision == cellId.size() &&
             data.cellPrecision in [3, 4, 5, 6];
    }

    function isValidSwipe(data) {
      return data.fromUserId is string && isValidId(data.fromUserId) &&
             data.toUserId is string && isValidId(data.toUserId) &&
             data.fromUserId != data.toUserId &&
             data.direction in ['LIKE', 'PASS'];
    }

    function isValidMatch(data) {
      return data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string && isValidId(data.participantUids[0]) &&
             data.participantUids[1] is string && isValidId(data.participantUids[1]) &&
             data.participantUids[0] < data.participantUids[1] &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.createdBy in data.participantUids &&
             (!('conversationType' in data) || data.conversationType in ['MATCH', 'DIRECT']) &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 300)) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && isValidId(data.lastMessageSenderId) && data.lastMessageSenderId in data.participantUids)) &&
             (!('lastMessageAt' in data) || isValidTimestamp(data.lastMessageAt)) &&
             (!('lastMessageReadByUids' in data) || (data.lastMessageReadByUids is list && data.lastMessageReadByUids.size() <= 2)) &&
             (!('disappearingTtlSeconds' in data) || (data.disappearingTtlSeconds is int && data.disappearingTtlSeconds in [0, 30, 300, 86400]));
    }

    function isMatchParticipant(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId)) &&
             request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantUids;
    }

    function isValidChatMessage(data, matchId) {
      return data.matchId is string && data.matchId == matchId &&
             data.senderId is string && isValidId(data.senderId) &&
             data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string && isValidId(data.participantUids[0]) &&
             data.participantUids[1] is string && isValidId(data.participantUids[1]) &&
             data.text is string && data.text.size() <= 1000 &&
             data.messageType in ['TEXT', 'PHOTO', 'VIDEO', 'VOICE', 'GIF', 'CALL'] &&
             (data.text.size() >= 1 || data.messageType in ['PHOTO', 'VIDEO', 'VOICE', 'GIF']) &&
             (!('mediaDataUrl' in data) || (data.mediaDataUrl is string && data.mediaDataUrl.size() <= 920000)) &&
             (!('mediaStoragePath' in data) || isValidStoragePath(data.mediaStoragePath)) &&
             (!('thumbnailDataUrl' in data) || (data.thumbnailDataUrl is string && data.thumbnailDataUrl.size() <= 180000)) &&
             (!('thumbnailStoragePath' in data) || isValidStoragePath(data.thumbnailStoragePath)) &&
             (!('mediaMimeType' in data) || (data.mediaMimeType is string && data.mediaMimeType.size() <= 80)) &&
             (!('mediaChunkCount' in data) || (data.mediaChunkCount is int && data.mediaChunkCount >= 0 && data.mediaChunkCount <= 1000)) &&
             (!('mediaByteSize' in data) || (data.mediaByteSize is int && data.mediaByteSize >= 0)) &&
             (!('mediaGifId' in data) || (data.mediaGifId is string && data.mediaGifId.size() <= 300)) &&
             (!('mediaDurationSec' in data) || (data.mediaDurationSec is int && data.mediaDurationSec >= 0)) &&
             (!('replyToMessageId' in data) || (data.replyToMessageId is string && data.replyToMessageId.size() <= 128)) &&
             (!('replyToSenderId' in data) || (data.replyToSenderId is string && isValidId(data.replyToSenderId))) &&
             (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() <= 300)) &&
             (!('replyToType' in data) || (data.replyToType is string && data.replyToType.size() <= 24)) &&
             (!('deletedForUids' in data) || (data.deletedForUids is list && data.deletedForUids.size() <= 2)) &&
             (!('unsent' in data) || data.unsent is bool) &&
             (!('unsentAt' in data) || isValidTimestamp(data.unsentAt)) &&
             (!('readByUids' in data) || (data.readByUids is list && data.readByUids.size() <= 2)) &&
             (!('readAt' in data) || isValidTimestamp(data.readAt)) &&
             (!('disappearingSeconds' in data) || (data.disappearingSeconds is int && data.disappearingSeconds >= 0 && data.disappearingSeconds <= 604800)) &&
             (!('viewOnce' in data) || data.viewOnce is bool) &&
             (!('openedByRecipient' in data) || data.openedByRecipient is bool) &&
             (!('expiresAtMs' in data) || (data.expiresAtMs is int && data.expiresAtMs > 0));
    }

    function isValidUserPresence(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.online is bool &&
             (!('hideOnlineStatus' in data) || data.hideOnlineStatus is bool) &&
             isValidTimestamp(data.lastSeenAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFcmToken(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.token is string && data.token.size() >= 10 && data.token.size() <= 512 &&
             data.platform == 'android' &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBlockRecord(data) {
      return data.blockerUid is string && isValidId(data.blockerUid) &&
             data.blockedUid is string && isValidId(data.blockedUid) &&
             data.blockerUid != data.blockedUid &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 200)) &&
             isValidTimestamp(data.createdAt);
    }

    function isNotBlockedBetween(uidA, uidB) {
      return !exists(/databases/$(database)/documents/blocks/$(uidA + '_' + uidB)) &&
             !exists(/databases/$(database)/documents/blocks/$(uidB + '_' + uidA));
    }

    function isValidReportRecord(data) {
      return data.reporterUid is string && isValidId(data.reporterUid) &&
             data.reportedUid is string && isValidId(data.reportedUid) &&
             data.reporterUid != data.reportedUid &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 100 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
             data.sourceSurface in ['DISCOVER', 'HOME_FEED', 'SEARCH', 'CHAT', 'PROFILE', 'USER_PROFILE', 'VIDEO_FEED', 'STORY', 'FEED_POST'] &&
             (!('matchId' in data) || isValidId(data.matchId)) &&
             (!('status' in data) || data.status in ['OPEN', 'RESOLVED', 'DISMISSED']) &&
             (!('resolvedBy' in data) || isValidId(data.resolvedBy)) &&
             (!('resolvedAt' in data) || isValidTimestamp(data.resolvedAt)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidModerationNotice(data) {
      return data.targetUid is string && isValidId(data.targetUid) &&
             data.moderatorUid is string && isValidId(data.moderatorUid) &&
             data.contentType in ['POST', 'REEL', 'STORY', 'PROFILE_VIDEO'] &&
             data.contentId is string && isValidId(data.contentId) &&
             (!('contentPreview' in data) || (data.contentPreview is string && data.contentPreview.size() <= 200)) &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 120 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
             data.read is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidMediaChunk(data) {
      return data.ownerUid is string && isValidId(data.ownerUid) &&
             (!('participantUids' in data) || (data.participantUids is list && data.participantUids.size() == 2)) &&
             data.seq is int && data.seq >= 0 && data.seq <= 1000 &&
             data.dataBase64 is string && data.dataBase64.size() >= 1 && data.dataBase64.size() <= 920000 &&
             isValidTimestamp(data.createdAt);
    }

    // --- Collection Rules ---

    // 0. Admin role lookup documents
    match /admins/{adminUid} {
      allow get: if isOwner(adminUid);
      allow list, write: if false;
    }

    // 1. Private User Account & Preferences (Owner-only PII isolation)
    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'interestedIn', 'minAgePref', 'maxAgePref', 'maxDistanceKm', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'interestedIn', 'minAgePref', 'maxAgePref', 'maxDistanceKm', 'hideOnlineStatus', 'exactLatitude', 'exactLongitude', 'createdAt', 'updatedAt']) &&
                       isValidPrivateUser(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidPrivateUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'interestedIn', 'minAgePref', 'maxAgePref', 'maxDistanceKm', 'hideOnlineStatus', 'exactLatitude', 'exactLongitude', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 2b. Device FCM Push Notification Tokens
      match /fcmTokens/{tokenId} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
                                 isValidId(userId) &&
                                 isValidId(tokenId) &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().keys().hasAll(['userId', 'token', 'platform', 'updatedAt']) &&
                                 incoming().keys().hasOnly(['userId', 'token', 'platform', 'updatedAt']) &&
                                 isValidFcmToken(incoming());

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(tokenId);
      }

      // 2c. Owner-only Saved Favorites
      match /favorites/{targetUid} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
                                 isValidId(userId) &&
                                 isValidId(targetUid) &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().targetUid == targetUid &&
                                 incoming().displayName is string && incoming().displayName.size() <= 40 &&
                                 incoming().keys().hasAll(['userId', 'targetUid', 'displayName', 'createdAt']) &&
                                 incoming().keys().hasOnly(['userId', 'targetUid', 'displayName', 'age', 'cityLabel', 'country', 'photoDataUrl', 'createdAt']) &&
                                 isValidTimestamp(incoming().createdAt);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(targetUid);
      }

      // 2d. Moderator Content-Removal Notices (/users/{userId}/moderationNotices/{noticeId})
      match /moderationNotices/{noticeId} {
        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(noticeId) &&
                         incoming().targetUid == userId &&
                         incoming().moderatorUid == request.auth.uid &&
                         incoming().read == false &&
                         incoming().keys().hasAll(['targetUid', 'moderatorUid', 'contentType', 'contentId', 'reason', 'read', 'createdAt']) &&
                         incoming().keys().hasOnly(['targetUid', 'moderatorUid', 'contentType', 'contentId', 'contentPreview', 'reason', 'details', 'read', 'createdAt']) &&
                         isValidModerationNotice(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(noticeId) &&
                         incoming().targetUid == existing().targetUid &&
                         incoming().moderatorUid == existing().moderatorUid &&
                         incoming().contentType == existing().contentType &&
                         incoming().contentId == existing().contentId &&
                         incoming().reason == existing().reason &&
                         incoming().createdAt == existing().createdAt &&
                         isValidModerationNotice(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(noticeId);
      }
    }

    // 3. Public Discovery Profiles (Coarse coordinates, GeoHash index, up to 12 photos)
    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && (existing().discoverable == true || isAdmin());

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'age', 'gender', 'bio', 'cityLabel', 'coarseLatitude', 'coarseLongitude', 'interests', 'avatarSeed', 'discoverable', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'age', 'dateOfBirth', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'geohash', 'geohash3', 'geohash4', 'interests', 'photoDataUrl', 'photoStoragePath', 'profilePhotos', 'photoStoragePaths', 'avatarSeed', 'discoverable', 'profileCompleted', 'suspended', 'hideOnlineStatus', 'photosVisibility', 'videosVisibility', 'infoVisibility', 'username', 'pronouns', 'profileLink', 'pageInfo', 'category', 'createdAt', 'updatedAt']) &&
                       isValidPublicProfile(incoming()) &&
                       !incoming().get('suspended', false) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if (
                       isOwner(userId) &&
                       isValidId(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().get('suspended', false) == existing().get('suspended', false) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'age', 'dateOfBirth', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'geohash', 'geohash3', 'geohash4', 'interests', 'photoDataUrl', 'photoStoragePath', 'profilePhotos', 'photoStoragePaths', 'avatarSeed', 'discoverable', 'profileCompleted', 'hideOnlineStatus', 'photosVisibility', 'videosVisibility', 'infoVisibility', 'username', 'pronouns', 'profileLink', 'pageInfo', 'category', 'updatedAt'])
                     ) || (
                       isAdmin() &&
                       isValidId(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['suspended', 'discoverable', 'updatedAt']) &&
                       isValidTimestamp(incoming().updatedAt)
                     );

      allow delete: if isOwner(userId) && isValidId(userId);

      // 3b. Profile Showcase Videos (/publicProfiles/{userId}/videos/{videoId})
      match /videos/{videoId} {
        allow get, list: if isSignedIn() && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(videoId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().caption is string && incoming().caption.size() <= 300 &&
                         incoming().mediaDurationSec is int && incoming().mediaDurationSec >= 0 &&
                         incoming().chunkCount is int && incoming().chunkCount >= 0 && incoming().chunkCount <= 1000 &&
                         (!('mediaDataUrl' in incoming()) || (incoming().mediaDataUrl is string && incoming().mediaDataUrl.size() <= 920000)) &&
                         (!('mediaStoragePath' in incoming()) || isValidStoragePath(incoming().mediaStoragePath)) &&
                         (!('thumbnailDataUrl' in incoming()) || (incoming().thumbnailDataUrl is string && incoming().thumbnailDataUrl.size() <= 180000)) &&
                         (!('thumbnailStoragePath' in incoming()) || isValidStoragePath(incoming().thumbnailStoragePath)) &&
                         (!('mediaMimeType' in incoming()) || (incoming().mediaMimeType is string && incoming().mediaMimeType.size() <= 80)) &&
                         (!('mediaByteSize' in incoming()) || (incoming().mediaByteSize is int && incoming().mediaByteSize >= 0)) &&
                         incoming().keys().hasAll(['userId', 'caption', 'mediaDurationSec', 'chunkCount', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'caption', 'mediaDataUrl', 'mediaStoragePath', 'thumbnailDataUrl', 'thumbnailStoragePath', 'mediaMimeType', 'mediaDurationSec', 'mediaByteSize', 'chunkCount', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt);

        allow update: if false;
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(videoId);

        match /mediaChunks/{chunkId} {
          allow get, list: if isSignedIn() && isValidId(userId) && isValidId(videoId);
          allow create: if isOwner(userId) &&
                           isValidId(userId) &&
                           isValidId(videoId) &&
                           isValidId(chunkId) &&
                           incoming().ownerUid == request.auth.uid &&
                           incoming().keys().hasAll(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                           incoming().keys().hasOnly(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                           isValidMediaChunk(incoming());
          allow update: if false;
          allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(videoId);
        }
      }
    }

    // 4. GeoHash Spatial Buckets (/geoCells/{cellId}/profiles/{userId})
    match /geoCells/{cellId}/profiles/{userId} {
      allow get: if isSignedIn() && isValidGeoCellId(cellId) && isValidId(userId) && (request.auth.uid == userId || existing().discoverable == true);
      allow list: if isSignedIn() && isValidGeoCellId(cellId) && existing().discoverable == true;

      allow create: if isOwner(userId) &&
                       isValidGeoCellId(cellId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'geohash', 'cellPrecision', 'displayName', 'age', 'gender', 'bio', 'cityLabel', 'coarseLatitude', 'coarseLongitude', 'interests', 'avatarSeed', 'discoverable', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'geohash', 'cellPrecision', 'displayName', 'age', 'dateOfBirth', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'interests', 'photoDataUrl', 'photoStoragePath', 'profilePhotos', 'photoStoragePaths', 'avatarSeed', 'discoverable', 'profileCompleted', 'suspended', 'hideOnlineStatus', 'photosVisibility', 'videosVisibility', 'infoVisibility', 'createdAt', 'updatedAt']) &&
                       isValidGeoCellProfile(incoming(), cellId) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isOwner(userId) &&
                       isValidGeoCellId(cellId) &&
                       isValidId(userId) &&
                       isValidGeoCellProfile(incoming(), cellId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['geohash', 'cellPrecision', 'displayName', 'age', 'dateOfBirth', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'interests', 'photoDataUrl', 'photoStoragePath', 'profilePhotos', 'photoStoragePaths', 'avatarSeed', 'discoverable', 'profileCompleted', 'hideOnlineStatus', 'photosVisibility', 'videosVisibility', 'infoVisibility', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidGeoCellId(cellId) && isValidId(userId);
    }

    // 5. Swipe Decisions ({fromUserId}_{toUserId})
    match /swipes/{swipeId} {
      allow get: if isSignedIn() && isValidId(swipeId) && (
        resource == null
          ? swipeId.matches('^(' + request.auth.uid + '_.*|.*_' + request.auth.uid + ')$')
          : (existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid)
      );
      allow list: if isSignedIn() && (existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(swipeId) &&
                       incoming().fromUserId == request.auth.uid &&
                       swipeId == (incoming().fromUserId + '_' + incoming().toUserId) &&
                       incoming().keys().hasAll(['fromUserId', 'toUserId', 'direction', 'createdAt']) &&
                       incoming().keys().hasOnly(['fromUserId', 'toUserId', 'direction', 'createdAt']) &&
                       isValidSwipe(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isNotBlockedBetween(incoming().fromUserId, incoming().toUserId) &&
