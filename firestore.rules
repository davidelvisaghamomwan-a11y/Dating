                           'mediaDataUrl', 'mediaStoragePath', 'thumbnailDataUrl', 'thumbnailStoragePath',
                           'mediaMimeType', 'mediaChunkCount', 'mediaByteSize',
                           'mediaGifId', 'mediaDurationSec',
                           'replyToMessageId', 'replyToSenderId', 'replyToText', 'replyToType',
                           'deletedForUids', 'unsent', 'unsentAt',
                           'readByUids', 'disappearingSeconds', 'viewOnce', 'openedByRecipient', 'expiresAtMs', 'createdAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isNotBlockedBetween(incoming().participantUids[0], incoming().participantUids[1]) &&
