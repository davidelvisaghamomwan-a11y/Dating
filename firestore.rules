      );
      allow list: if isSignedIn() && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(likeId) &&
                       incoming().fromUid == request.auth.uid &&
                       incoming().fromUid != incoming().toUid &&
                       isValidId(incoming().toUid) &&
                       likeId == (incoming().fromUid + '_' + incoming().toUid) &&
                       incoming().keys().hasAll(['fromUid', 'toUid', 'createdAt']) &&
                       incoming().keys().hasOnly(['fromUid', 'toUid', 'createdAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isNotBlockedBetween(incoming().fromUid, incoming().toUid);

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(likeId) && existing().fromUid == request.auth.uid;
    }

    function isValidStory(data) {
      return data.userId is string &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             data.mediaType in ['PHOTO', 'VIDEO'] &&
             (!('authorPhoto' in data) || (data.authorPhoto is string && data.authorPhoto.size() <= 180000)) &&
             (!('authorCountry' in data) || (data.authorCountry is string && data.authorCountry.size() <= 80)) &&
             (!('mediaDataUrl' in data) || (data.mediaDataUrl is string && data.mediaDataUrl.size() <= 920000)) &&
             (!('mediaStoragePath' in data) || isValidStoragePath(data.mediaStoragePath)) &&
             (!('thumbnailDataUrl' in data) || (data.thumbnailDataUrl is string && data.thumbnailDataUrl.size() <= 180000)) &&
             (!('thumbnailStoragePath' in data) || isValidStoragePath(data.thumbnailStoragePath)) &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 300)) &&
             (!('mediaDurationSec' in data) || (data.mediaDurationSec is int && data.mediaDurationSec >= 0)) &&
             (!('chunkCount' in data) || (data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 1000)) &&
             (!('viewerUids' in data) || (data.viewerUids is list && data.viewerUids.size() <= 500)) &&
             (!('expiresAt' in data) || data.expiresAt is timestamp) &&
             data.expiresAtMs is int && data.expiresAtMs > 0;
    }

    function isValidHighlight(data) {
      return data.userId is string &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 40 &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 180000)) &&
             (!('coverStoragePath' in data) || isValidStoragePath(data.coverStoragePath)) &&
             (!('storyItems' in data) || (data.storyItems is list && data.storyItems.size() <= 100));
    }

    function isValidFeedPost(data) {
      return data.userId is string &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             data.caption is string && data.caption.size() <= 1000 &&
             data.mediaType in ['NONE', 'TEXT', 'PHOTO', 'VIDEO'] &&
             (!('authorPhoto' in data) || (data.authorPhoto is string && data.authorPhoto.size() <= 180000)) &&
             (!('authorCountry' in data) || (data.authorCountry is string && data.authorCountry.size() <= 80)) &&
             (!('authorCity' in data) || (data.authorCity is string && data.authorCity.size() <= 80)) &&
             (!('mediaDataUrl' in data) || (data.mediaDataUrl is string && data.mediaDataUrl.size() <= 920000)) &&
             (!('mediaStoragePath' in data) || isValidStoragePath(data.mediaStoragePath)) &&
             (!('mediaUrls' in data) || (data.mediaUrls is list && data.mediaUrls.size() <= 6 && (data.mediaUrls.size() == 0 || (data.mediaUrls[0] is string && data.mediaUrls[0].size() <= 180000)))) &&
             (!('mediaStoragePaths' in data) || isValidStoragePathList(data.mediaStoragePaths, 6)) &&
             (!('thumbnailDataUrl' in data) || (data.thumbnailDataUrl is string && data.thumbnailDataUrl.size() <= 180000)) &&
             (!('thumbnailStoragePath' in data) || isValidStoragePath(data.thumbnailStoragePath)) &&
             (!('mediaMimeType' in data) || (data.mediaMimeType is string && data.mediaMimeType.size() <= 80)) &&
             (!('mediaDurationSec' in data) || (data.mediaDurationSec is int && data.mediaDurationSec >= 0)) &&
             (!('mediaByteSize' in data) || (data.mediaByteSize is int && data.mediaByteSize >= 0)) &&
             (!('chunkCount' in data) || (data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 1000)) &&
             (!('likedByUids' in data) || (data.likedByUids is list && data.likedByUids.size() <= 1000)) &&
             (!('savedByUids' in data) || (data.savedByUids is list && data.savedByUids.size() <= 1000)) &&
             (!('commentCount' in data) || (data.commentCount is int && data.commentCount >= 0));
    }

    // 15. 24-Hour Ephemeral Stories (/stories/{storyId} + mediaChunks)
    match /stories/{storyId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().userId == request.auth.uid &&
                       isValidStory(incoming()) &&
                       incoming().keys().hasAll(['userId', 'authorName', 'mediaType', 'expiresAtMs', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorName', 'authorPhoto', 'authorCountry', 'mediaType', 'mediaDataUrl', 'mediaStoragePath', 'thumbnailDataUrl', 'thumbnailStoragePath', 'caption', 'mediaDurationSec', 'chunkCount', 'viewerUids', 'expiresAt', 'expiresAtMs', 'createdAt']) &&
                       isValidTimestamp(incoming().createdAt);

      allow update: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidStory(incoming()) &&
                       (
                         isOwner(existing().userId) ||
                         isAdmin() ||
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['viewerUids']) &&
                           request.auth.uid in incoming().viewerUids &&
                           incoming().viewerUids.hasAll(existing().get('viewerUids', []))
                         )
                       );

      allow delete: if isSignedIn() && isValidId(storyId) && (isOwner(existing().userId) || isAdmin());

      match /mediaChunks/{chunkId} {
        allow get, list: if isSignedIn() && isValidId(storyId);
        allow create: if isSignedIn() &&
                         isValidId(storyId) &&
                         isValidId(chunkId) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().keys().hasAll(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                         incoming().keys().hasOnly(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                         isValidMediaChunk(incoming());
        allow update: if false;
        allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      }
    }

    // 16. Story Highlights (/highlights/{highlightId})
    match /highlights/{highlightId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(highlightId) &&
                       incoming().userId == request.auth.uid &&
                       isValidHighlight(incoming()) &&
                       incoming().keys().hasAll(['userId', 'title', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'coverUrl', 'coverStoragePath', 'storyItems', 'createdAt']) &&
                       isValidTimestamp(incoming().createdAt);

      allow update: if isSignedIn() &&
                       isValidId(highlightId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidHighlight(incoming()) &&
                       (isOwner(existing().userId) || isAdmin());

      allow delete: if isSignedIn() && isValidId(highlightId) && (isOwner(existing().userId) || isAdmin());
    }

    // 17. Video Feed Posts (/videoPosts/{postId} + mediaChunks)
    match /videoPosts/{postId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().authorName is string && incoming().authorName.size() >= 1 && incoming().authorName.size() <= 40 &&
                       incoming().caption is string && incoming().caption.size() <= 300 &&
                       (!('authorPhoto' in incoming()) || (incoming().authorPhoto is string && incoming().authorPhoto.size() <= 180000)) &&
                       (!('authorCountry' in incoming()) || (incoming().authorCountry is string && incoming().authorCountry.size() <= 80)) &&
                       (!('mediaDataUrl' in incoming()) || (incoming().mediaDataUrl is string && incoming().mediaDataUrl.size() <= 920000)) &&
                       (!('mediaStoragePath' in incoming()) || isValidStoragePath(incoming().mediaStoragePath)) &&
                       (!('thumbnailDataUrl' in incoming()) || (incoming().thumbnailDataUrl is string && incoming().thumbnailDataUrl.size() <= 180000)) &&
                       (!('thumbnailStoragePath' in incoming()) || isValidStoragePath(incoming().thumbnailStoragePath)) &&
                       (!('mediaMimeType' in incoming()) || (incoming().mediaMimeType is string && incoming().mediaMimeType.size() <= 80)) &&
                       incoming().mediaDurationSec is int && incoming().mediaDurationSec >= 0 &&
                       (!('mediaByteSize' in incoming()) || (incoming().mediaByteSize is int && incoming().mediaByteSize >= 0)) &&
                       incoming().chunkCount is int && incoming().chunkCount >= 0 && incoming().chunkCount <= 1000 &&
                       (!('likedByUids' in incoming()) || (incoming().likedByUids is list && incoming().likedByUids.size() <= 1000)) &&
                       incoming().keys().hasAll(['userId', 'authorName', 'caption', 'mediaDurationSec', 'chunkCount', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorName', 'authorPhoto', 'authorCountry', 'caption', 'mediaDataUrl', 'mediaStoragePath', 'thumbnailDataUrl', 'thumbnailStoragePath', 'mediaMimeType', 'mediaDurationSec', 'mediaByteSize', 'chunkCount', 'likedByUids', 'createdAt']) &&
                       isValidTimestamp(incoming().createdAt);

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isOwner(existing().userId) ||
                         isAdmin() ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['likedByUids'])
                       );

      allow delete: if isSignedIn() && isValidId(postId) && (isOwner(existing().userId) || isAdmin());

      match /mediaChunks/{chunkId} {
        allow get, list: if isSignedIn() && isValidId(postId);
        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(chunkId) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().keys().hasAll(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                         incoming().keys().hasOnly(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                         isValidMediaChunk(incoming());
        allow update: if false;
        allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow get, list: if isSignedIn() && isValidId(postId);

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().postId == postId &&
                         incoming().userId == request.auth.uid &&
                         incoming().authorName is string && incoming().authorName.size() >= 1 && incoming().authorName.size() <= 40 &&
                         (!('authorPhoto' in incoming()) || (incoming().authorPhoto is string && incoming().authorPhoto.size() <= 180000)) &&
                         incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 500 &&
                         isValidCommentReplyFields(incoming()) &&
                         incoming().keys().hasAll(['postId', 'userId', 'authorName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'userId', 'authorName', 'authorPhoto', 'text', 'replyToCommentId', 'replyToAuthorName', 'replyToText', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt);

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && (
          isOwner(existing().userId) ||
          isAdmin() ||
          get(/databases/$(database)/documents/videoPosts/$(postId)).data.userId == request.auth.uid
        );
      }
    }

    // 18. Discover Social Timeline Feed Posts (/feedPosts/{postId} + mediaChunks + comments/{commentId})
    match /feedPosts/{postId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == request.auth.uid &&
                       isValidFeedPost(incoming()) &&
                       incoming().keys().hasAll(['userId', 'authorName', 'caption', 'mediaType', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorName', 'authorPhoto', 'authorCountry', 'authorCity', 'caption', 'mediaType', 'mediaDataUrl', 'mediaStoragePath', 'mediaUrls', 'mediaStoragePaths', 'thumbnailDataUrl', 'thumbnailStoragePath', 'mediaMimeType', 'mediaDurationSec', 'mediaByteSize', 'chunkCount', 'likedByUids', 'savedByUids', 'commentCount', 'createdAt']) &&
                       isValidTimestamp(incoming().createdAt);

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidFeedPost(incoming()) &&
                       (
                         isOwner(existing().userId) ||
                         isAdmin() ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['likedByUids', 'savedByUids', 'commentCount'])
                       );

      allow delete: if isSignedIn() && isValidId(postId) && (isOwner(existing().userId) || isAdmin());

      match /mediaChunks/{chunkId} {
        allow get, list: if isSignedIn() && isValidId(postId);
        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(chunkId) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().keys().hasAll(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                         incoming().keys().hasOnly(['ownerUid', 'seq', 'dataBase64', 'createdAt']) &&
                         isValidMediaChunk(incoming());
        allow update: if false;
        allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow get, list: if isSignedIn() && isValidId(postId);

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().postId == postId &&
                         incoming().userId == request.auth.uid &&
                         incoming().authorName is string && incoming().authorName.size() >= 1 && incoming().authorName.size() <= 40 &&
                         (!('authorPhoto' in incoming()) || (incoming().authorPhoto is string && incoming().authorPhoto.size() <= 180000)) &&
                         incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 500 &&
                         (!('likedByUids' in incoming()) || (incoming().likedByUids is list && incoming().likedByUids.size() <= 1000)) &&
                         isValidCommentReplyFields(incoming()) &&
                         incoming().keys().hasAll(['postId', 'userId', 'authorName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'userId', 'authorName', 'authorPhoto', 'text', 'likedByUids', 'replyToCommentId', 'replyToAuthorName', 'replyToText', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt);

        allow update: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().postId == existing().postId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().likedByUids is list && incoming().likedByUids.size() <= 1000 &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['likedByUids']);

        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && (
          isOwner(existing().userId) ||
          isAdmin() ||
          get(/databases/$(database)/documents/feedPosts/$(postId)).data.userId == request.auth.uid
        );
      }
    }
  }
}
