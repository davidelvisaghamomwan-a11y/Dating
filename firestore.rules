rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGeoCellId(cellId) {
      return cellId is string && cellId.size() >= 3 && cellId.size() <= 6 && cellId.matches('^[0-9b-hjkmnp-z]+$');
    }

    function isValidGeoHashString(gh) {
      return gh is string && gh.size() >= 4 && gh.size() <= 12 && gh.matches('^[0-9b-hjkmnp-z]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Entity Validation Helpers ---
    function isValidPrivateUser(data) {
      return data.userId is string && isValidId(data.userId) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             data.interestedIn in ['Everyone', 'Women', 'Men', 'Non-binary'] &&
             data.minAgePref is int && data.minAgePref >= 18 && data.minAgePref <= 99 &&
             data.maxAgePref is int && data.maxAgePref >= data.minAgePref && data.maxAgePref <= 99 &&
             data.maxDistanceKm is int && data.maxDistanceKm >= 5 && data.maxDistanceKm <= 500 &&
             data.verifiedOnlyFilter is bool &&
             (!('exactLatitude' in data) || (data.exactLatitude is number && data.exactLatitude >= -90.0 && data.exactLatitude <= 90.0)) &&
             (!('exactLongitude' in data) || (data.exactLongitude is number && data.exactLongitude >= -180.0 && data.exactLongitude <= 180.0));
    }

    function isValidVerificationRecord(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.challengeCode is string && data.challengeCode.size() >= 3 && data.challengeCode.size() <= 64 &&
             data.challengePrompt is string && data.challengePrompt.size() >= 5 && data.challengePrompt.size() <= 160 &&
             data.faceCount is int && data.faceCount >= 1 && data.faceCount <= 3 &&
             data.faceConfidence is number && data.faceConfidence >= 0.45 && data.faceConfidence <= 1.0 &&
             data.eyesDistancePx is number && data.eyesDistancePx >= 8.0 && data.eyesDistancePx <= 5000.0 &&
             data.photoSha256 is string && data.photoSha256.size() == 64 && data.photoSha256.matches('^[a-f0-9]{64}$') &&
             data.locationVerified is bool &&
             data.googleVerified is bool &&
             data.comparedPhotoCount is int && data.comparedPhotoCount >= 1 && data.comparedPhotoCount <= 10 &&
             data.photoSimilarityScore is number && data.photoSimilarityScore >= 0.65 && data.photoSimilarityScore <= 1.0 &&
             data.livenessPassed == true &&
             data.faceMatchPassed == true;
    }

    function isValidSharedProfileFields(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40 &&
             data.age is int && data.age >= 18 && data.age <= 99 &&
             data.gender in ['Woman', 'Man', 'Non-binary'] &&
             data.bio is string && data.bio.size() <= 400 &&
             data.cityLabel is string && data.cityLabel.size() >= 1 && data.cityLabel.size() <= 80 &&
             (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
             data.coarseLatitude is number && data.coarseLatitude >= -90.0 && data.coarseLatitude <= 90.0 &&
             data.coarseLongitude is number && data.coarseLongitude >= -180.0 && data.coarseLongitude <= 180.0 &&
             data.interests is list && data.interests.size() <= 8 &&
             (data.interests.size() == 0 || (data.interests[0] is string && data.interests[0].size() <= 40)) &&
             (!('photoDataUrl' in data) || (data.photoDataUrl is string && data.photoDataUrl.size() <= 180000)) &&
             (!('profilePhotos' in data) || (data.profilePhotos is list && data.profilePhotos.size() <= 4 && (data.profilePhotos.size() == 0 || (data.profilePhotos[0] is string && data.profilePhotos[0].size() <= 180000)))) &&
             data.avatarSeed is string && data.avatarSeed.size() >= 1 && data.avatarSeed.size() <= 40 &&
             data.discoverable is bool &&
             data.verificationStatus in ['UNVERIFIED', 'VERIFIED'] &&
             data.verificationScore is int && data.verificationScore >= 0 && data.verificationScore <= 100 &&
             (!('verificationId' in data) || (data.verificationId is string && data.verificationId.size() <= 128)) &&
             (!('verificationHash' in data) || (data.verificationHash is string && data.verificationHash.size() <= 64)) &&
             (!('verifiedAt' in data) || isValidTimestamp(data.verifiedAt)) &&
             (data.verificationStatus == 'UNVERIFIED' || (
               data.verificationScore >= 70 &&
               ('verificationId' in data) && isValidId(data.verificationId) &&
               ('verificationHash' in data) && data.verificationHash is string && data.verificationHash.size() == 64 && data.verificationHash.matches('^[a-f0-9]{64}$') &&
               ('verifiedAt' in data) && isValidTimestamp(data.verifiedAt)
             ));
    }

    function isValidPublicProfile(data) {
      return isValidSharedProfileFields(data) &&
             (!('geohash' in data) || isValidGeoHashString(data.geohash)) &&
             (!('geohash3' in data) || (data.geohash3 is string && data.geohash3.size() == 3 && data.geohash3.matches('^[0-9b-hjkmnp-z]{3}$'))) &&
             (!('geohash4' in data) || (data.geohash4 is string && data.geohash4.size() == 4 && data.geohash4.matches('^[0-9b-hjkmnp-z]{4}$')));
    }

    function isValidGeoCellProfile(data, cellId) {
      return isValidSharedProfileFields(data) &&
             isValidGeoHashString(data.geohash) &&
             data.geohash.matches('^' + cellId + '.*') &&
             data.cellPrecision is int &&
             data.cellPrecision == cellId.size() &&
             data.cellPrecision in [3, 4, 5, 6];
    }

    function isValidSwipe(data) {
      return data.fromUserId is string && isValidId(data.fromUserId) &&
             data.toUserId is string && isValidId(data.toUserId) &&
             data.fromUserId != data.toUserId &&
             data.direction in ['LIKE', 'PASS'];
    }

    function isValidMatch(data) {
      return data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string && isValidId(data.participantUids[0]) &&
             data.participantUids[1] is string && isValidId(data.participantUids[1]) &&
             data.participantUids[0] < data.participantUids[1] &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.createdBy in data.participantUids &&
             (!('conversationType' in data) || data.conversationType in ['MATCH', 'DIRECT']) &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 300)) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && isValidId(data.lastMessageSenderId) && data.lastMessageSenderId in data.participantUids)) &&
             (!('lastMessageAt' in data) || isValidTimestamp(data.lastMessageAt)) &&
             (!('lastMessageReadByUids' in data) || (data.lastMessageReadByUids is list && data.lastMessageReadByUids.size() <= 2)) &&
             (!('disappearingTtlSeconds' in data) || (data.disappearingTtlSeconds is int && data.disappearingTtlSeconds in [0, 30, 300, 86400]));
    }

    function isMatchParticipant(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId)) &&
             request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantUids;
    }

    function isValidChatMessage(data, matchId) {
      return data.matchId is string && data.matchId == matchId &&
             data.senderId is string && isValidId(data.senderId) &&
             data.participantUids is list &&
             data.participantUids.size() == 2 &&
             data.participantUids[0] is string && isValidId(data.participantUids[0]) &&
             data.participantUids[1] is string && isValidId(data.participantUids[1]) &&
             data.text is string && data.text.size() <= 1000 &&
             data.messageType in ['TEXT', 'ICEBREAKER', 'PHOTO', 'VOICE', 'GIF', 'CALL'] &&
             (data.text.size() >= 1 || data.messageType in ['PHOTO', 'VOICE', 'GIF']) &&
             (!('mediaDataUrl' in data) || (data.mediaDataUrl is string && data.mediaDataUrl.size() <= 260000)) &&
             (!('mediaGifId' in data) || (data.mediaGifId is string && data.mediaGifId.size() <= 300)) &&
             (!('mediaDurationSec' in data) || (data.mediaDurationSec is int && data.mediaDurationSec >= 0 && data.mediaDurationSec <= 120)) &&
             (!('readByUids' in data) || (data.readByUids is list && data.readByUids.size() <= 2)) &&
             (!('readAt' in data) || isValidTimestamp(data.readAt)) &&
             (!('disappearingSeconds' in data) || (data.disappearingSeconds is int && data.disappearingSeconds >= 0 && data.disappearingSeconds <= 604800)) &&
             (!('viewOnce' in data) || data.viewOnce is bool) &&
             (!('openedByRecipient' in data) || data.openedByRecipient is bool) &&
             (!('expiresAtMs' in data) || (data.expiresAtMs is int && data.expiresAtMs > 0));
    }

    function isValidUserPresence(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.online is bool &&
             isValidTimestamp(data.lastSeenAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFcmToken(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.token is string && data.token.size() >= 10 && data.token.size() <= 512 &&
             data.platform == 'android' &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBlockRecord(data) {
      return data.blockerUid is string && isValidId(data.blockerUid) &&
             data.blockedUid is string && isValidId(data.blockedUid) &&
             data.blockerUid != data.blockedUid &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 200)) &&
             isValidTimestamp(data.createdAt);
    }

    function isNotBlockedBetween(uidA, uidB) {
      return !exists(/databases/$(database)/documents/blocks/$(uidA + '_' + uidB)) &&
             !exists(/databases/$(database)/documents/blocks/$(uidB + '_' + uidA));
    }

    // --- Collection Rules ---

    // 1. Private User Account & Preferences (Owner-only PII isolation)
    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'interestedIn', 'minAgePref', 'maxAgePref', 'maxDistanceKm', 'verifiedOnlyFilter', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'interestedIn', 'minAgePref', 'maxAgePref', 'maxDistanceKm', 'verifiedOnlyFilter', 'exactLatitude', 'exactLongitude', 'createdAt', 'updatedAt']) &&
                       isValidPrivateUser(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidPrivateUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'interestedIn', 'minAgePref', 'maxAgePref', 'maxDistanceKm', 'verifiedOnlyFilter', 'exactLatitude', 'exactLongitude', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. Immutable Live-Camera Verification Audit Subcollection
      match /verifications/{verificationId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(verificationId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'challengeCode', 'challengePrompt', 'faceCount', 'faceConfidence', 'eyesDistancePx', 'photoSha256', 'locationVerified', 'googleVerified', 'comparedPhotoCount', 'photoSimilarityScore', 'livenessPassed', 'faceMatchPassed', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'challengeCode', 'challengePrompt', 'faceCount', 'faceConfidence', 'eyesDistancePx', 'photoSha256', 'locationVerified', 'googleVerified', 'comparedPhotoCount', 'photoSimilarityScore', 'livenessPassed', 'faceMatchPassed', 'createdAt']) &&
                         isValidVerificationRecord(incoming()) &&
                         isValidTimestamp(incoming().createdAt);

        allow update, delete: if false;
      }

      // 2b. Device FCM Push Notification Tokens
      match /fcmTokens/{tokenId} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
                                 isValidId(userId) &&
                                 isValidId(tokenId) &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().keys().hasAll(['userId', 'token', 'platform', 'updatedAt']) &&
                                 incoming().keys().hasOnly(['userId', 'token', 'platform', 'updatedAt']) &&
                                 isValidFcmToken(incoming());

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(tokenId);
      }
    }

    // 3. Public Discovery Profiles (Coarse coordinates, GeoHash index & verification proof)
    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || existing().discoverable == true);
      allow list: if isSignedIn() && existing().discoverable == true;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'age', 'gender', 'bio', 'cityLabel', 'coarseLatitude', 'coarseLongitude', 'interests', 'avatarSeed', 'discoverable', 'verificationStatus', 'verificationScore', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'age', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'geohash', 'geohash3', 'geohash4', 'interests', 'photoDataUrl', 'profilePhotos', 'avatarSeed', 'discoverable', 'verificationStatus', 'verificationId', 'verificationScore', 'verificationHash', 'verifiedAt', 'createdAt', 'updatedAt']) &&
                       isValidPublicProfile(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       (
                         incoming().verificationStatus == 'UNVERIFIED' ||
                         (
                           existsAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)) &&
                           getAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)).data.photoSha256 == incoming().verificationHash
                         )
                       );

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'age', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'geohash', 'geohash3', 'geohash4', 'interests', 'photoDataUrl', 'profilePhotos', 'avatarSeed', 'discoverable', 'verificationStatus', 'verificationId', 'verificationScore', 'verificationHash', 'verifiedAt', 'updatedAt']) &&
                       (
                         incoming().verificationStatus == 'UNVERIFIED' ||
                         (
                           existsAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)) &&
                           getAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)).data.photoSha256 == incoming().verificationHash
                         )
                       );

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 4. GeoHash Spatial Buckets (/geoCells/{cellId}/profiles/{userId})
    match /geoCells/{cellId}/profiles/{userId} {
      allow get: if isSignedIn() && isValidGeoCellId(cellId) && isValidId(userId) && (request.auth.uid == userId || existing().discoverable == true);
      allow list: if isSignedIn() && isValidGeoCellId(cellId) && existing().discoverable == true;

      allow create: if isOwner(userId) &&
                       isValidGeoCellId(cellId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'geohash', 'cellPrecision', 'displayName', 'age', 'gender', 'bio', 'cityLabel', 'coarseLatitude', 'coarseLongitude', 'interests', 'avatarSeed', 'discoverable', 'verificationStatus', 'verificationScore', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'geohash', 'cellPrecision', 'displayName', 'age', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'interests', 'photoDataUrl', 'profilePhotos', 'avatarSeed', 'discoverable', 'verificationStatus', 'verificationId', 'verificationScore', 'verificationHash', 'verifiedAt', 'createdAt', 'updatedAt']) &&
                       isValidGeoCellProfile(incoming(), cellId) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       (
                         incoming().verificationStatus == 'UNVERIFIED' ||
                         (
                           existsAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)) &&
                           getAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)).data.photoSha256 == incoming().verificationHash
                         )
                       );

      allow update: if isOwner(userId) &&
                       isValidGeoCellId(cellId) &&
                       isValidId(userId) &&
                       isValidGeoCellProfile(incoming(), cellId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['geohash', 'cellPrecision', 'displayName', 'age', 'gender', 'bio', 'cityLabel', 'country', 'coarseLatitude', 'coarseLongitude', 'interests', 'photoDataUrl', 'profilePhotos', 'avatarSeed', 'discoverable', 'verificationStatus', 'verificationId', 'verificationScore', 'verificationHash', 'verifiedAt', 'updatedAt']) &&
                       (
                         incoming().verificationStatus == 'UNVERIFIED' ||
                         (
                           existsAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)) &&
                           getAfter(/databases/$(database)/documents/users/$(userId)/verifications/$(incoming().verificationId)).data.photoSha256 == incoming().verificationHash
                         )
                       );

      allow delete: if isOwner(userId) && isValidGeoCellId(cellId) && isValidId(userId);
    }

    // 5. Swipe Decisions ({fromUserId}_{toUserId})
    match /swipes/{swipeId} {
      allow get: if isSignedIn() && isValidId(swipeId) && (existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid);
      allow list: if isSignedIn() && (existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(swipeId) &&
                       incoming().fromUserId == request.auth.uid &&
                       swipeId == (incoming().fromUserId + '_' + incoming().toUserId) &&
                       incoming().keys().hasAll(['fromUserId', 'toUserId', 'direction', 'createdAt']) &&
                       incoming().keys().hasOnly(['fromUserId', 'toUserId', 'direction', 'createdAt']) &&
                       isValidSwipe(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isNotBlockedBetween(incoming().fromUserId, incoming().toUserId) &&
                       exists(/databases/$(database)/documents/publicProfiles/$(incoming().toUserId));

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(swipeId) && existing().fromUserId == request.auth.uid;
    }

    // 6. Mutual Matches (sorted {uid1}_{uid2})
    match /matches/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isSignedIn() &&
                       isValidId(matchId) &&
                       isValidMatch(incoming()) &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().createdBy == request.auth.uid &&
                       matchId == (incoming().participantUids[0] + '_' + incoming().participantUids[1]) &&
                       incoming().keys().hasAll(['participantUids', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['participantUids', 'createdBy', 'conversationType', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'lastMessageReadByUids', 'disappearingTtlSeconds', 'createdAt', 'updatedAt']) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isNotBlockedBetween(incoming().participantUids[0], incoming().participantUids[1]) &&
                       (
                         (
                           existsAfter(/databases/$(database)/documents/swipes/$(incoming().participantUids[0] + '_' + incoming().participantUids[1])) &&
                           existsAfter(/databases/$(database)/documents/swipes/$(incoming().participantUids[1] + '_' + incoming().participantUids[0])) &&
                           getAfter(/databases/$(database)/documents/swipes/$(incoming().participantUids[0] + '_' + incoming().participantUids[1])).data.direction == 'LIKE' &&
                           getAfter(/databases/$(database)/documents/swipes/$(incoming().participantUids[1] + '_' + incoming().participantUids[0])).data.direction == 'LIKE'
                         ) ||
                         (
                           ('conversationType' in incoming()) &&
                           incoming().conversationType == 'DIRECT' &&
                           exists(/databases/$(database)/documents/publicProfiles/$(incoming().participantUids[0])) &&
                           exists(/databases/$(database)/documents/publicProfiles/$(incoming().participantUids[1])) &&
                           (
                             (incoming().participantUids[0] == request.auth.uid && get(/databases/$(database)/documents/publicProfiles/$(incoming().participantUids[1])).data.discoverable == true) ||
                             (incoming().participantUids[1] == request.auth.uid && get(/databases/$(database)/documents/publicProfiles/$(incoming().participantUids[0])).data.discoverable == true)
                           )
                         )
                       );

      allow update: if isSignedIn() &&
                       isValidId(matchId) &&
                       request.auth.uid in existing().participantUids &&
                       isValidMatch(incoming()) &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'lastMessageReadByUids', 'disappearingTtlSeconds', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(matchId) && request.auth.uid in existing().participantUids;

      // 7. Real-Time Chat Messages Subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(matchId) && isValidId(messageId) && request.auth.uid in existing().participantUids;
        allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

        allow create: if isSignedIn() &&
                         isValidId(matchId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming(), matchId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().keys().hasAll(['matchId', 'senderId', 'participantUids', 'text', 'messageType', 'createdAt']) &&
                         incoming().keys().hasOnly(['matchId', 'senderId', 'participantUids', 'text', 'messageType', 'mediaDataUrl', 'mediaGifId', 'mediaDurationSec', 'readByUids', 'disappearingSeconds', 'viewOnce', 'openedByRecipient', 'expiresAtMs', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isNotBlockedBetween(incoming().participantUids[0], incoming().participantUids[1]) &&
                         exists(/databases/$(database)/documents/matches/$(matchId)) &&
                         incoming().participantUids == get(/databases/$(database)/documents/matches/$(matchId)).data.participantUids;

        allow update: if isSignedIn() &&
                         isValidId(matchId) &&
                         isValidId(messageId) &&
                         request.auth.uid in existing().participantUids &&
                         isValidChatMessage(incoming(), matchId) &&
                         incoming().matchId == existing().matchId &&
                         incoming().senderId == existing().senderId &&
                         incoming().participantUids == existing().participantUids &&
                         incoming().text == existing().text &&
                         incoming().messageType == existing().messageType &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['readByUids', 'readAt', 'openedByRecipient', 'expiresAtMs']) &&
                         ('readByUids' in incoming()) &&
                         request.auth.uid in incoming().readByUids &&
                         existing().senderId in incoming().readByUids;

        allow delete: if isSignedIn() &&
                         isValidId(matchId) &&
                         isValidId(messageId) &&
                         request.auth.uid in existing().participantUids &&
                         (
                           existing().senderId == request.auth.uid ||
                           (('expiresAtMs' in existing()) && existing().expiresAtMs is int) ||
                           (('disappearingSeconds' in existing()) && existing().disappearingSeconds > 0)
                         );
      }

      // 7b. Real-Time Typing Indicators (/matches/{matchId}/typing/{typingUserId})
      match /typing/{typingUserId} {
        allow get, list: if isSignedIn() && isValidId(matchId) && isMatchParticipant(matchId);

        allow create, update: if isOwner(typingUserId) &&
                                 isValidId(matchId) &&
                                 isValidId(typingUserId) &&
                                 isMatchParticipant(matchId) &&
                                 incoming().matchId == matchId &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().keys().hasAll(['matchId', 'userId', 'isTyping', 'updatedAt']) &&
                                 incoming().keys().hasOnly(['matchId', 'userId', 'isTyping', 'updatedAt']) &&
                                 incoming().isTyping is bool &&
                                 isValidTimestamp(incoming().updatedAt);

        allow delete: if isOwner(typingUserId) && isValidId(matchId);
      }

      // 7c. In-App Voice & Video Call Signaling (/matches/{matchId}/calls/{callId})
      match /calls/{callId} {
        allow get, list: if isSignedIn() && isValidId(matchId) && request.auth.uid in existing().participantUids;

        allow create: if isSignedIn() &&
                         isValidId(matchId) &&
                         isValidId(callId) &&
                         isMatchParticipant(matchId) &&
                         incoming().matchId == matchId &&
                         incoming().callerUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().participantUids == get(/databases/$(database)/documents/matches/$(matchId)).data.participantUids &&
                         incoming().calleeUid in incoming().participantUids &&
                         incoming().callerUid != incoming().calleeUid &&
                         incoming().callType in ['VOICE', 'VIDEO'] &&
                         incoming().status == 'RINGING' &&
                         incoming().callerMuted is bool &&
                         incoming().calleeMuted is bool &&
                         incoming().callerCameraOn is bool &&
                         incoming().calleeCameraOn is bool &&
                         incoming().keys().hasAll(['matchId', 'callerUid', 'calleeUid', 'participantUids', 'callType', 'status', 'callerMuted', 'calleeMuted', 'callerCameraOn', 'calleeCameraOn', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['matchId', 'callerUid', 'calleeUid', 'participantUids', 'callType', 'status', 'callerMuted', 'calleeMuted', 'callerCameraOn', 'calleeCameraOn', 'createdAt', 'updatedAt', 'endedAtMs']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt) &&
                         isNotBlockedBetween(incoming().participantUids[0], incoming().participantUids[1]);

        allow update: if isSignedIn() &&
                         isValidId(matchId) &&
                         isValidId(callId) &&
                         request.auth.uid in existing().participantUids &&
                         incoming().matchId == existing().matchId &&
                         incoming().callerUid == existing().callerUid &&
                         incoming().calleeUid == existing().calleeUid &&
                         incoming().participantUids == existing().participantUids &&
                         incoming().callType == existing().callType &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().status in ['RINGING', 'ACTIVE', 'DECLINED', 'ENDED'] &&
                         incoming().callerMuted is bool &&
                         incoming().calleeMuted is bool &&
                         incoming().callerCameraOn is bool &&
                         incoming().calleeCameraOn is bool &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'callerMuted', 'calleeMuted', 'callerCameraOn', 'calleeCameraOn', 'updatedAt', 'endedAtMs']);

        allow delete: if isSignedIn() && isValidId(matchId) && request.auth.uid in existing().participantUids;
      }
    }

    // 8. Real-Time User Presence (/presence/{userId})
    match /presence/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'online', 'lastSeenAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'online', 'lastSeenAt', 'updatedAt']) &&
                       isValidUserPresence(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       isValidUserPresence(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['online', 'lastSeenAt', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 9. User Blocks (/blocks/{blockId}) - bidirectional safety exclusion
    match /blocks/{blockId} {
      allow get, list: if isSignedIn() &&
                          (existing().blockerUid == request.auth.uid || existing().blockedUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(blockId) &&
                       incoming().blockerUid == request.auth.uid &&
                       blockId == (incoming().blockerUid + '_' + incoming().blockedUid) &&
                       incoming().keys().hasAll(['blockerUid', 'blockedUid', 'createdAt']) &&
                       incoming().keys().hasOnly(['blockerUid', 'blockedUid', 'reason', 'createdAt']) &&
                       isValidBlockRecord(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(blockId) && existing().blockerUid == request.auth.uid;
    }
  }
}
