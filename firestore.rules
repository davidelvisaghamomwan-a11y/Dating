        allow delete: if isSignedIn() && isValidId(matchId) && request.auth.uid in existing().participantUids;

        // 7d. Live In-App Call Audio Chunks (/matches/{matchId}/calls/{callId}/audioChunks/{chunkId})
        match /audioChunks/{chunkId} {
