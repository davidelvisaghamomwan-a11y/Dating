      allow delete: if isSignedIn() && isValidId(matchId) && request.auth.uid in existing().participantUids;

      // 7. Real-Time Chat Messages Subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(matchId) && isValidId(messageId) && request.auth.uid in existing().participantUids;
        allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

        allow create: if isSignedIn() &&
                         isValidId(matchId) &&
                         isValidId(messageId) &&
