rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      // Any authenticated Kindred member can view uploaded profile, feed, story, reel, and chat media URLs.
      allow read: if request.auth != null;

      // Only the authenticated owner may upload, overwrite, or delete files under users/{userId}/...
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          request.resource == null
          || (
            (
              request.resource.contentType.matches('image/.*')
              && request.resource.size > 0
              && request.resource.size <= 15 * 1024 * 1024
            )
            || (
              request.resource.contentType.matches('video/.*')
              && request.resource.size > 0
              && request.resource.size <= 150 * 1024 * 1024
            )
            || (
              request.resource.contentType.matches('audio/.*')
              && request.resource.size > 0
              && request.resource.size <= 25 * 1024 * 1024
            )
          )
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
